# Frontend — Variables d'environnement (template, copié vers .env.local)
#
# - Dev local : `cp .env.example .env.local` puis adapter.
# - Vercel prod : configurer dans le dashboard (Settings > Environment Variables).

# URL de l'API Symfony (staff tenant — /api/*)
# Dev   : http://localhost:8080/api
# Prod  : https://your-app.herokuapp.com/api
VITE_API_URL=http://localhost:8080/api

# URL Mercure SSE
# Dev   : http://localhost:9090/.well-known/mercure
# Prod  : https://your-mercure.herokuapp.com/.well-known/mercure
VITE_MERCURE_URL=http://localhost:9090/.well-known/mercure

# Uploadcare (clé publique uniquement — jamais la clé secrète côté frontend)
VITE_UPLOADCARE_PUBLIC_KEY=

# Domaine de l'app
VITE_APP_DOMAIN=stayos.localhost

# Slug tenant pour le login en dev local (pas de subdomain).
# En prod, le tenant est résolu via le subdomain — laisser vide.
VITE_DEFAULT_TENANT_SLUG=

# URL du back-office SuperAdmin (préfixe /superadmin/...).
# Vide en dev = chemin absolu sur le même host.
# Prod : si SuperAdmin sur host séparé, ex https://api.getstayos.com
VITE_SUPERADMIN_URL=

# Sentry — DSN du projet frontend (@sentry/vue, Sprint 14-C).
# Dev local   : LAISSER VIDE → Sentry ne s'initialise pas (cf. main.ts).
# Prod Vercel : poser via dashboard Vercel (Settings > Environment Variables).
VITE_SENTRY_DSN=
