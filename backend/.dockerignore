# ──────────────────────────────────────────────────────────────────────────────
#  .dockerignore — Backend (build context = backend/ pour Dockerfile.prod)
#
#  Sprint 14-C. S'applique au build de `backend/Dockerfile.prod` exécuté
#  par Heroku container stack avec contexte = backend/ (Heroku fige le
#  contexte au dossier qui contient le Dockerfile — d'où l'emplacement
#  à la racine de backend/, cf. commentaire en tête du Dockerfile).
#
#  Objectifs :
#   1. AUCUN secret dans l'image (clés JWT, .env.local, etc.)
#   2. Image légère (pas de vendor, var/cache, tests, fixtures de dev)
#   3. Build déterministe (pas de fichiers générés type IDE, OS)
# ──────────────────────────────────────────────────────────────────────────────

# ── Secrets — JAMAIS dans l'image
.env.local
.env.local.php
.env.*.local
config/jwt/*.pem
config/jwt/*.key

# Sentry release token éventuel
.sentryclirc

# ── Dépendances regénérées dans le build
vendor/
node_modules/

# ── Caches et données générées Symfony
var/cache/
var/log/
var/coverage/
var/data/
var/sessions/

# ── Tests (image prod n'a pas besoin de phpunit ni des tests)
tests/
phpunit.xml
phpunit.xml.dist
.phpunit.result.cache

# ── Outillage dev
.php-cs-fixer.cache
.phpstan-cache/
.phpstan.cache/
phpstan.neon
.php-cs-fixer.dist.php
.php-cs-fixer.php

# ── Métadonnées Git
.git/
.gitignore
.gitattributes

# ── Fichiers IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker dev (le contenu de docker/ est principalement de la config
#    Nginx/Mailpit/etc. uniquement utile en dev — on ne le met pas dans
#    l'image prod). On garde explicitement le Caddyfile via négation,
#    référencé par `COPY docker/php/Caddyfile …` dans Dockerfile.prod.
#    (Le Dockerfile.prod lui-même vit désormais à backend/Dockerfile.prod,
#    donc plus besoin de l'exclure de la règle `docker/`.)
docker/
!docker/php/Caddyfile

# ── Documentation et CI
README.md
CHANGELOG.md
.github/

# ── Fichier heroku.yml lui-même (utile à Heroku, pas à l'image)
heroku.yml
