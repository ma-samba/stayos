<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1A1714; font-size: 14px; line-height: 1.6; background: #F5F0E8; margin: 0; padding: 0; }
        .wrapper { max-width: 560px; margin: 30px auto; background: #fff; border-radius: 12px; padding: 32px; }
        .logo { font-size: 18px; font-weight: 600; color: #1A1714; margin-bottom: 24px; }
        h1 { font-size: 20px; font-weight: 500; margin-bottom: 16px; }
        .ref { font-family: 'Courier New', monospace; color: #1D6E6E; font-size: 14px; font-weight: 500; }
        .amount { font-size: 24px; font-weight: 600; color: #1A1714; margin: 16px 0; }
        .details { background: #F5F0E8; border-radius: 8px; padding: 16px; margin: 20px 0; font-size: 13px; }
        .details-row { display: flex; justify-content: space-between; padding: 4px 0; }
        .details-label { color: #6B6459; }
        .cta { display: inline-block; background: #1A1714; color: #fff !important; padding: 12px 22px; border-radius: 8px; text-decoration: none; font-weight: 500; margin: 12px 0; }
        .cta.gold { background: #C4922A; }
        .cta.danger { background: #B83232; }
        .alert-box { border-left: 3px solid #C4922A; background: #F5E6C8; padding: 12px 16px; border-radius: 6px; margin: 16px 0; }
        .alert-box.danger { border-left-color: #B83232; background: #F5DADA; }
        .footer { font-size: 11px; color: #6B6459; text-align: center; margin-top: 28px; padding-top: 16px; border-top: 1px solid #EDE7D9; }
        p { margin: 0 0 12px; }
    </style>
</head>
<body>
<div class="wrapper">
    <div class="logo">StayOS</div>
    {% block content %}{% endblock %}
    <div class="footer">
        Cet email a été envoyé automatiquement par StayOS.<br>
        Pour toute question, contactez <a href="mailto:support@stayos.sn">support@stayos.sn</a>.
    </div>
</div>
</body>
</html>
