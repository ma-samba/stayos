{% extends 'email/subscription/_base.html.twig' %}

{% block content %}
    <p>Bonjour {{ recipientName }},</p>

    <h1>Votre essai expire demain</h1>

    <div class="alert-box">
        Sans abonnement choisi avant le {{ trialEndsAt|date('d/m/Y') }} à
        {{ trialEndsAt|date('H:i') }}, l'accès à <strong>{{ hotelName }}</strong>
        sera suspendu.
    </div>

    <p>
        Vous pouvez activer un abonnement en quelques minutes — vos données et
        vos réglages restent intacts.
    </p>

    <p>
        <a class="cta danger" href="{{ pricingUrl }}">Activer mon abonnement</a>
    </p>
{% endblock %}
