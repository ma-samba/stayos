{% extends 'email/subscription/_base.html.twig' %}

{% block content %}
    <p>Bonjour {{ recipientName }},</p>

    <h1>Votre facture StayOS — {{ invoice.number }}</h1>

    <p>
        Voici la facture de votre abonnement <strong>{{ hotelName }}</strong> pour
        la période du {{ invoice.periodStart|date('d/m/Y') }} au
        {{ invoice.periodEnd|date('d/m/Y') }}.
    </p>

    <div class="amount">{{ invoice.amountXof|number_format(0, ',', ' ') }} FCFA</div>

    <div class="details">
        <div class="details-row">
            <span class="details-label">Plan</span>
            <span>{{ invoice.planName }}</span>
        </div>
        {% if invoice.dueAt %}
        <div class="details-row">
            <span class="details-label">Échéance</span>
            <span>{{ invoice.dueAt|date('d/m/Y') }}</span>
        </div>
        {% endif %}
    </div>

    {% if invoice.checkoutUrl %}
    <p>
        <a class="cta" href="{{ invoice.checkoutUrl }}">Régler la facture</a>
    </p>
    <p style="font-size:13px;color:#6B6459;">
        Vous pouvez payer par Wave, Orange Money ou carte bancaire via Paydunya.
    </p>
    {% endif %}

    <p style="font-size:13px;color:#6B6459;">
        Sans règlement avant l'échéance, l'accès à StayOS sera automatiquement
        suspendu pour cet hôtel.
    </p>
{% endblock %}
