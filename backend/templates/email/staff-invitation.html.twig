{% extends 'email/subscription/_base.html.twig' %}

{% set role_labels = {
    'MANAGER': 'Manager',
    'RECEPTIONIST': 'Réceptionniste',
    'ACCOUNTANT': 'Comptable',
    'HOUSEKEEPER': 'Femme/Valet de chambre',
} %}

{% block content %}
    <p>Bonjour {{ invitation.firstName }},</p>

    <h1>Invitation à rejoindre {{ hotelName }} sur StayOS</h1>

    <p>
        Vous avez été invité(e) à rejoindre l'équipe de
        <strong>{{ hotelName }}</strong> sur StayOS, le logiciel
        professionnel de gestion hôtelière.
    </p>

    <div class="details">
        <div class="details-row">
            <span class="details-label">Hôtel</span>
            <span>{{ hotelName }}</span>
        </div>
        <div class="details-row">
            <span class="details-label">Email</span>
            <span>{{ invitation.email }}</span>
        </div>
        <div class="details-row">
            <span class="details-label">Rôle proposé</span>
            <span>{{ role_labels[invitation.role] ?? invitation.role }}</span>
        </div>
        <div class="details-row">
            <span class="details-label">Valable jusqu'au</span>
            <span>{{ invitation.expiresAt|date('d/m/Y') }}</span>
        </div>
    </div>

    <p>
        <a class="cta" href="{{ url }}">Activer mon compte</a>
    </p>

    <p style="font-size:13px;color:#6B6459;">
        Ce lien est valable 7 jours. Au-delà, demandez à votre manager
        de vous envoyer une nouvelle invitation.
    </p>

    <p style="font-size:12px;color:#6B6459;">
        Si vous n'êtes pas à l'origine de cette demande, ignorez
        simplement cet email — votre compte ne sera pas créé.
    </p>
{% endblock %}
