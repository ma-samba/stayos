<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-size: 13px;
            color: #1A1714;
            line-height: 1.5;
        }
        .page { padding: 45px 50px; }

        .hotel-name { font-size: 22px; font-weight: 600; margin-bottom: 4px; }
        .hotel-info { font-size: 11px; color: #6B6459; line-height: 1.6; }

        .invoice-title { font-size: 26px; font-weight: 300; text-align: right; color: #1A1714; }
        .invoice-number { font-size: 14px; font-family: 'Courier New', monospace; color: #1D6E6E; margin-top: 4px; text-align: right; }
        .invoice-meta { font-size: 11px; color: #6B6459; text-align: right; margin-top: 6px; line-height: 1.6; }

        .client-block { background: #F5F0E8; border-radius: 6px; padding: 14px 18px; margin-bottom: 24px; }
        .client-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: #6B6459; font-weight: 500; margin-bottom: 6px; }
        .client-name { font-size: 15px; font-weight: 500; }
        .client-info { font-size: 12px; color: #3D3830; }

        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        thead th {
            font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em;
            color: #6B6459; font-weight: 500; text-align: left;
            padding: 10px 12px; border-bottom: 1px solid #EDE7D9;
        }
        thead th:last-child, thead th:nth-child(3), thead th:nth-child(4) { text-align: right; }
        tbody td { padding: 10px 12px; border-bottom: 1px solid #F5F0E8; font-size: 13px; }
        tbody td:last-child, tbody td:nth-child(3), tbody td:nth-child(4) { text-align: right; }

        .totals { width: 280px; margin-left: auto; }
        .totals td { padding: 6px 0; font-size: 13px; border: none; }
        .totals td.label { color: #6B6459; text-align: left; }
        .totals td.value { text-align: right; }
        .totals tr.total td { font-size: 16px; font-weight: 600; border-top: 2px solid #1A1714; padding-top: 10px; }

        .payments-section { margin-top: 28px; }
        .section-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: #6B6459; font-weight: 500; margin-bottom: 10px; }
        .payments-table { width: 100%; border-collapse: collapse; }
        .payments-table td { padding: 6px 0; font-size: 12px; border-bottom: 1px solid #F5F0E8; border-top: none; }
        .payments-table td:last-child { text-align: right; }
        .payment-method { font-weight: 500; }
        .payment-date { color: #6B6459; }

        .balance-table { width: 100%; background: #F5F0E8; border-collapse: collapse; margin-top: 16px; }
        .balance-table td { padding: 12px 18px; border: none; }
        .balance-label { font-size: 13px; font-weight: 500; }
        .balance-value { font-size: 18px; font-weight: 600; text-align: right; }
        .balance-paid { color: #2E7D4F; }
        .balance-due { color: #B83232; }

        .notes { margin-top: 28px; font-size: 11px; color: #6B6459; }
        .notes-label { font-weight: 500; margin-bottom: 4px; }

        .footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid #EDE7D9; font-size: 10px; color: #6B6459; text-align: center; }
    </style>
</head>
<body>
<div class="page">

<table style="width:100%;border:none;margin-bottom:30px;">
    <tr>
        <td style="border:none;padding:0;width:60%;vertical-align:top;">
            <div class="hotel-name">{{ hotel ? hotel.name : 'StayOS Hotel' }}</div>
            <div class="hotel-info">
                {% if hotel and hotel.address %}{{ hotel.address }}<br>{% endif %}
                {% if hotel and hotel.city %}{{ hotel.city }}, {{ hotel.country|default('SN') }}<br>{% endif %}
                {% if hotel and hotel.phone %}{{ hotel.phone }}<br>{% endif %}
                {% if hotel and hotel.email %}{{ hotel.email }}{% endif %}
            </div>
        </td>
        <td style="border:none;padding:0;width:40%;vertical-align:top;">
            <div class="invoice-title">FACTURE</div>
            <div class="invoice-number">{{ invoice.number }}</div>
            <div class="invoice-meta">
                {% if invoice.issuedAt %}
                    Date : {{ invoice.issuedAt|date('d/m/Y') }}<br>
                {% endif %}
                {% if invoice.dueAt %}
                    Échéance : {{ invoice.dueAt|date('d/m/Y') }}<br>
                {% endif %}
                Statut : {{ invoice.status|upper }}
            </div>
        </td>
    </tr>
</table>

{% set guest = invoice.reservation.guest %}
<div class="client-block">
    <div class="client-label">Client</div>
    <div class="client-name">{{ guest.firstName }} {{ guest.lastName }}</div>
    <div class="client-info">
        {% if guest.email %}{{ guest.email }}<br>{% endif %}
        {% if guest.phone %}{{ guest.phone }}{% endif %}
    </div>
</div>

<div class="section-title">Prestations</div>
<table>
    <thead>
        <tr>
            <th>Description</th>
            <th>Qté</th>
            <th>P.U. (FCFA)</th>
            <th>Total (FCFA)</th>
        </tr>
    </thead>
    <tbody>
        {% for line in invoice.lines %}
        <tr>
            <td>{{ line.label }}</td>
            <td>{{ line.quantity }}</td>
            <td>{{ line.unitPriceXof|number_format(0, ',', ' ') }}</td>
            <td>{{ line.totalXof|number_format(0, ',', ' ') }}</td>
        </tr>
        {% else %}
        <tr>
            <td>Séjour — {{ invoice.reservation.room.number }}</td>
            <td>{{ invoice.reservation.checkIn.diff(invoice.reservation.checkOut).days }}</td>
            <td>{{ invoice.reservation.rateXof|number_format(0, ',', ' ') }}</td>
            <td>{{ invoice.totalXof|number_format(0, ',', ' ') }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<table class="totals">
    <tr>
        <td class="label">Sous-total HT</td>
        <td class="value">{{ invoice.subtotalXof|number_format(0, ',', ' ') }} FCFA</td>
    </tr>
    <tr>
        <td class="label">TVA ({{ invoice.taxRate }}%)</td>
        <td class="value">{{ invoice.taxXof|number_format(0, ',', ' ') }} FCFA</td>
    </tr>
    <tr class="total">
        <td class="label">Total TTC</td>
        <td class="value">{{ invoice.totalXof|number_format(0, ',', ' ') }} FCFA</td>
    </tr>
</table>

{% set payments = invoice.payments %}
{% if payments|length > 0 %}
<div class="payments-section">
    <div class="section-title">Paiements</div>
    <table class="payments-table">
        {% for payment in payments %}
            {% if payment.status == 'paid' %}
            <tr>
                <td>
                    <span class="payment-method">{{ payment.method|upper }}</span>
                    {% if payment.reference %} — {{ payment.reference }}{% endif %}
                </td>
                <td>
                    <span class="payment-date">{{ payment.paidAt ? payment.paidAt|date('d/m/Y') : payment.processedAt|date('d/m/Y') }}</span>
                    {{ payment.amountXof|number_format(0, ',', ' ') }} FCFA
                </td>
            </tr>
            {% endif %}
        {% endfor %}
    </table>
</div>
{% endif %}

{% set balance = invoice.balanceXof %}
<table class="balance-table">
    <tr>
        <td class="balance-label">Solde restant</td>
        <td class="balance-value {{ balance == '0.00' or balance <= 0 ? 'balance-paid' : 'balance-due' }}">
            {{ balance|number_format(0, ',', ' ') }} FCFA
        </td>
    </tr>
</table>

{% if invoice.notes %}
<div class="notes">
    <div class="notes-label">Notes</div>
    {{ invoice.notes }}
</div>
{% endif %}

<div class="footer">
    {{ hotel ? hotel.name : 'StayOS Hotel' }}
    {% if hotel and hotel.address %} — {{ hotel.address }}{% endif %}
    {% if hotel and hotel.city %}, {{ hotel.city }}{% endif %}
    {% if hotel and hotel.phone %} — {{ hotel.phone }}{% endif %}
</div>

</div>
</body>
</html>
