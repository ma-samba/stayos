<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Clôture journalière — {{ close.businessDate|date('d/m/Y') }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: Helvetica, sans-serif;
            font-size: 12px;
            color: #1A1714;
            line-height: 1.45;
        }
        .page { padding: 38px 46px; }

        .header { text-align: center; margin-bottom: 18px; }
        .hotel-name { font-size: 18px; font-weight: 600; }
        .hotel-info { font-size: 10px; color: #6B6459; margin-top: 2px; }
        .doc-title { font-size: 15px; font-weight: 500; margin-top: 14px; }
        .doc-subtitle { font-size: 11px; color: #6B6459; margin-top: 4px; }

        .reopened-banner {
            background: #FBE5E5;
            border-left: 3px solid #B83232;
            color: #B83232;
            padding: 8px 12px;
            margin: 14px 0 6px;
            font-size: 11px;
            font-weight: 600;
        }

        .forced-banner {
            background: #FFF3D6;
            border-left: 3px solid #C4922A;
            color: #8A6319;
            padding: 8px 12px;
            margin: 14px 0 6px;
            font-size: 11px;
            font-weight: 600;
        }

        .section { margin-top: 18px; }
        .section-title {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #6B6459;
            font-weight: 500;
            border-bottom: 1px solid #EDE7D9;
            padding-bottom: 5px;
            margin-bottom: 8px;
        }

        table { width: 100%; border-collapse: collapse; }
        table.kv td { padding: 5px 10px; font-size: 12px; border-bottom: 1px solid #F5F0E8; }
        table.kv td.label { color: #6B6459; }
        table.kv td.value { text-align: right; font-weight: 500; }

        table.grid th, table.grid td {
            padding: 5px 8px; font-size: 11px;
            border-bottom: 1px solid #F5F0E8;
            text-align: left;
        }
        table.grid th {
            background: #F5F0E8;
            color: #3D3830;
            font-weight: 600;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        table.grid td.num { text-align: right; }

        .totals-row td { font-weight: 600; border-top: 2px solid #1A1714; padding-top: 8px; }

        .badge-status {
            display: inline-block;
            padding: 1px 6px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: 600;
        }
        .badge-available { background: #D4EDE0; color: #2E7D4F; }
        .badge-occupied  { background: #F5DADA; color: #B83232; }
        .badge-cleaning  { background: #F5E6C8; color: #8A6319; }
        .badge-maintenance { background: #D4E2F5; color: #2B5BA8; }
        .badge-out_of_order { background: #DCDCDC; color: #555; }
        .badge-checked_in { background: #D4EDED; color: #0D4444; }

        .warning-item {
            border-left: 3px solid #C4922A;
            background: #FBF6E8;
            padding: 8px 12px;
            margin-bottom: 6px;
            font-size: 11px;
        }
        .warning-label { font-weight: 600; color: #8A6319; }
        .warning-message { color: #3D3830; margin-top: 2px; }
        .warning-detail-list { margin-top: 4px; font-size: 10px; color: #6B6459; }

        .footer {
            margin-top: 30px;
            padding-top: 10px;
            border-top: 1px solid #EDE7D9;
            font-size: 9px;
            color: #6B6459;
            text-align: center;
        }
    </style>
</head>
<body>
<div class="page">

    {# ── En-tête ── #}
    <div class="header">
        {% if hotel %}
            <div class="hotel-name">{{ hotel.name }}</div>
            <div class="hotel-info">
                {{ hotel.address }}{% if hotel.city %} · {{ hotel.city }}{% endif %}
                {% if hotel.phone %} · {{ hotel.phone }}{% endif %}
            </div>
        {% else %}
            <div class="hotel-name">StayOS</div>
        {% endif %}
        <div class="doc-title">Clôture journalière — {{ close.businessDate|date('d/m/Y') }}</div>
        <div class="doc-subtitle">
            Clôturée le {{ close.closedAt|date('d/m/Y H:i') }} par {{ close.closedByEmail }}
            (cutoff {{ close.cutoffHour }}h)
        </div>
    </div>

    {% if close.reopened %}
        <div class="reopened-banner">
            DOCUMENT RÉOUVERT le {{ close.reopenedAt|date('d/m/Y H:i') }}
            par {{ close.reopenedByEmail }}{% if close.reopenReason %} — {{ close.reopenReason }}{% endif %}
        </div>
    {% endif %}

    {% set snapshot = close.snapshot %}
    {% set kpis     = snapshot.kpis|default({}) %}
    {% set counts   = snapshot.counts|default({}) %}
    {% set cash     = snapshot.cash|default({}) %}
    {% set invoices = snapshot.invoices|default({}) %}
    {% set rooms    = snapshot.rooms|default([]) %}
    {% set warnings = snapshot.warnings|default([]) %}

    {% if warnings|length > 0 %}
        <div class="forced-banner">
            CLÔTURE FORCÉE avec {{ warnings|length }} avertissement(s) — voir section dédiée en bas.
        </div>
    {% endif %}

    {# ── KPIs ── #}
    <div class="section">
        <div class="section-title">KPIs du jour</div>
        <table class="kv">
            <tr><td class="label">Taux d'occupation</td><td class="value">{{ kpis.occupancyRate|default('0.00') }} %</td></tr>
            <tr><td class="label">ADR HT</td><td class="value">{{ kpis.adrHtXof|default('0.00') }} XOF</td></tr>
            <tr><td class="label">RevPAR HT</td><td class="value">{{ kpis.revparHtXof|default('0.00') }} XOF</td></tr>
            <tr><td class="label">Chiffre d'affaires HT</td><td class="value">{{ kpis.revenueHtXof|default('0.00') }} XOF</td></tr>
            <tr><td class="label">Chiffre d'affaires TTC</td><td class="value">{{ kpis.revenueTtcXof|default('0.00') }} XOF</td></tr>
            <tr><td class="label">Nuits vendues / disponibles</td><td class="value">{{ kpis.soldNights|default(0) }} / {{ kpis.availableNights|default(0) }}</td></tr>
        </table>
    </div>

    {# ── Activité ── #}
    <div class="section">
        <div class="section-title">Activité du jour</div>
        <table class="kv">
            <tr><td class="label">Arrivées prévues</td><td class="value">{{ counts.arrivals|default(0) }}</td></tr>
            <tr><td class="label">Départs prévus</td><td class="value">{{ counts.departures|default(0) }}</td></tr>
            <tr><td class="label">Chambres occupées / disponibles</td><td class="value">{{ kpis.occupiedRooms|default(0) }} / {{ kpis.availableRooms|default(0) }}</td></tr>
        </table>
    </div>

    {# ── Caisse ── #}
    <div class="section">
        <div class="section-title">Caisse encaissée</div>
        {% set byMethod = cash.byMethod|default({}) %}
        {% if byMethod|length == 0 %}
            <table class="kv"><tr><td class="label" style="color:#6B6459; font-style:italic;">Aucun paiement enregistré.</td></tr></table>
        {% else %}
            <table class="kv">
                {% for method, amount in byMethod %}
                    <tr>
                        <td class="label">{{ method|capitalize|replace({'_': ' '}) }}</td>
                        <td class="value">{{ amount }} XOF</td>
                    </tr>
                {% endfor %}
                <tr class="totals-row">
                    <td class="label">Total encaissé</td>
                    <td class="value">{{ cash.totalXof|default('0.00') }} XOF</td>
                </tr>
            </table>
        {% endif %}
    </div>

    {# ── Factures ── #}
    {% set totalTtc = invoices.totalXof|default('0.00') %}
    {% set vatAmount = totalTtc > 0 ? (totalTtc / 1.18 * 0.18) : 0 %}
    <div class="section">
        <div class="section-title">Factures émises</div>
        <table class="kv">
            <tr><td class="label">Nombre de factures émises</td><td class="value">{{ invoices.issued|default(0) }}</td></tr>
            <tr><td class="label">Total TTC</td><td class="value">{{ totalTtc }} XOF</td></tr>
            <tr><td class="label">Dont TVA (18%) ≈</td><td class="value">{{ vatAmount|number_format(2, '.', '') }} XOF</td></tr>
        </table>
    </div>

    {# ── État des chambres (instant T) ── #}
    <div class="section">
        <div class="section-title">État des chambres (instant T)</div>
        {% if rooms|length == 0 %}
            <p style="color:#6B6459; font-size:11px; font-style:italic;">Aucune chambre.</p>
        {% else %}
            <table class="grid">
                <thead><tr><th>N°</th><th>Statut</th></tr></thead>
                <tbody>
                    {% for room in rooms|slice(0, 50) %}
                        <tr>
                            <td>{{ room.number }}</td>
                            <td><span class="badge-status badge-{{ room.status }}">{{ room.status|replace({'_': ' '}) }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% if rooms|length > 50 %}
                <p style="font-size:10px; color:#6B6459; margin-top:4px;">… et {{ rooms|length - 50 }} autres chambres non affichées.</p>
            {% endif %}
        {% endif %}
    </div>

    {# ── Avertissements ── #}
    {% if warnings|length > 0 %}
        <div class="section">
            <div class="section-title">Avertissements (clôture forcée)</div>
            {% for w in warnings %}
                <div class="warning-item">
                    <span class="warning-label">{{ w.label }}</span>
                    <span style="color:#6B6459;"> · {{ w.count }} élément(s)</span>
                    <div class="warning-message">{{ w.message }}</div>
                    {% if w.details is defined and w.details|length > 0 %}
                        <ul class="warning-detail-list">
                            {% for d in w.details %}
                                <li>
                                    {% if d.confirmationNumber is defined %}
                                        {{ d.confirmationNumber }} — {{ d.guest|default('-') }} (ch. {{ d.room|default('-') }})
                                    {% elseif d.number is defined %}
                                        {{ d.number }} — {{ d.totalXof|default('-') }} XOF ({{ d.reservation|default('-') }})
                                    {% else %}
                                        Chambre {{ d.number|default(d.id) }}
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="footer">
        Document généré le {{ "now"|date('d/m/Y H:i') }} — StayOS
        {% if snapshot.meta is defined and snapshot.meta.generatedAt is defined %}
            (snapshot figé le {{ snapshot.meta.generatedAt|date('d/m/Y H:i') }})
        {% endif %}
    </div>
</div>
</body>
</html>
