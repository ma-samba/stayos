# Variables d'environnement pour l'environnement de test
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
APP_DEBUG=0

# BDD de test (séparée du dev)
DATABASE_URL="postgresql://stayos_user:stayos_password@db:5432/stayos_test?serverVersion=16&charset=utf8"

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages_test

# JWT
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=stayos_jwt_dev_secret

# Mail — null transport en test
MAILER_DSN=null://null

# Mercure — désactivé en test
MERCURE_URL=http://mercure:9090/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:9090/.well-known/mercure
MERCURE_JWT_SECRET=stayos_mercure_test_secret

# Paydunya en mode sandbox
PAYDUNYA_MODE=test

# CORS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

LOCK_DSN=flock
APP_DOMAIN=stayos.localhost

# Backend URL (utilisé pour les callbacks Paydunya, etc.)
APP_BACKEND_URL=http://localhost:8080
