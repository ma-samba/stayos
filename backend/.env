APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_for_production_32_chars_min
APP_VERSION=1.0.0
APP_DOMAIN=stayos.localhost

DATABASE_URL="postgresql://stayos_user:stayos_password@db:5432/stayos_db?serverVersion=16&charset=utf8"

REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=stayos_jwt_dev_secret

MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@stayos.sn

MERCURE_URL=http://mercure:9090/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:9090/.well-known/mercure
MERCURE_JWT_SECRET=stayos_mercure_dev_secret_min_32bytes_long_pad

FRONTEND_URL=http://localhost:5173
SUPERADMIN_URL=http://superadmin.localhost:8080

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

LOCK_DSN=flock
DEFAULT_URI=http://localhost

# URL backend publique pour les callbacks Paydunya.
# Défaut local : http://localhost:8080. En dev avec ngrok ou en prod,
# surcharger APP_BACKEND_URL dans backend/.env.local (gitignoré).
APP_BACKEND_URL=http://localhost:8080

# ── Paydunya ─────────────────────────────────────────────────
# Les vraies clés (même test) vivent dans backend/.env.local.
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# ── Uploadcare ───────────────────────────────────────────────
# Les vraies clés vivent dans backend/.env.local.
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=

SENTRY_DSN=
