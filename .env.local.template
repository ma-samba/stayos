# ════════════════════════════════════════════════════════════════════════════
# STAYOS — Variables d'environnement locales
# Copier ce fichier en .env.local — NE JAMAIS COMMITTER .env.local
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_SECRET=change_me_32_chars_minimum_secret
APP_DOMAIN=stayos.localhost
APP_VERSION=1.0.0

# ── Base de données (Docker en local, RDS en prod) ────────────────────────────
POSTGRES_DB=stayos_db
POSTGRES_USER=stayos_user
POSTGRES_PASSWORD=stayos_password

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_PASSPHRASE=stayos_jwt_dev_secret

# ── Mercure (SSE temps réel) ─────────────────────────────────────────────────
MERCURE_JWT_SECRET=stayos_mercure_dev_secret

# ── Mail ─────────────────────────────────────────────────────────────────────
# Dev local → Mailpit (ne jamais changer en dev)
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@stayos.sn
# Prod → MAILER_DSN=mailjet+api://API_KEY:API_SECRET@default

# ── Mailjet ───────────────────────────────────────────────────────────────────
MAILJET_API_KEY=
MAILJET_API_SECRET=

# ── Paydunya — Paiement ──────────────────────────────────────────────────────
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
# Prod : PAYDUNYA_MODE=live avec les clés live

# ── Uploadcare — CDN Images ───────────────────────────────────────────────────
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=

# ── Sentry — Supervision erreurs ─────────────────────────────────────────────
# Laisser vide en dev (pas de Sentry local) — obligatoire en prod
SENTRY_DSN=

# ── Frontend (lus par Vite) ───────────────────────────────────────────────────
# Ces variables sont également dans frontend/.env.local
VITE_API_URL=http://localhost:8080/api
VITE_MERCURE_URL=http://localhost:9090/.well-known/mercure
VITE_UPLOADCARE_PUBLIC_KEY=
VITE_APP_DOMAIN=stayos.localhost
